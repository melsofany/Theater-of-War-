; Theater of War - Godot project configuration
config_version=5

[application]

config/name="Theater of War"
config/description="A military theater-level real-time strategy game."
run/main_scene="res://src/UI/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://src/Core/GameManager.gd"
SelectionManager="*res://src/Core/SelectionManager.gd"
ControlGroupManager="*res://src/Core/ControlGroupManager.gd"
Economy="*res://src/Economy/Economy.gd"
UnitFactory="*res://src/Units/UnitFactory.gd"
CommandTree="*res://src/Core/CommandTree.gd"
Logistics="*res://src/Logistics/Logistics.gd"
Intelligence="*res://src/Intelligence/Intelligence.gd"

[editor_plugins]

enabled=PackedStringArray("gut")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

