[gd_resource type="ShaderMaterial" format=3]
[sub_resource type="Shader" id="Shader_window_grid"]
code = "shader_type spatial;\nrender_mode cull_back, diffuse_burley, specular_schlick_ggx;\nuniform vec4 glass_tint : source_color = vec4(0.07, 0.16, 0.25, 1.0);\nuniform vec4 window_light : source_color = vec4(0.28, 0.39, 0.47, 1.0);\nuniform float horizontal_count = 42.0;\nuniform float vertical_count = 12.0;\nvoid fragment() {\n    vec2 grid = UV * vec2(vertical_count, horizontal_count);\n    vec2 cell = fract(grid);\n    float frame = step(cell.x, 0.028) + step(1.0 - cell.x, 0.028) + step(cell.y, 0.020) + step(1.0 - cell.y, 0.020);\n    float seed = fract(sin(dot(floor(grid), vec2(12.9898, 78.233))) * 43758.5453);\n    float lit = step(0.76, seed);\n    float pane_variation = 0.84 + seed * 0.16;\n    float fresnel = pow(1.0 - max(dot(normalize(NORMAL), normalize(VIEW)), 0.0), 2.0);\n    vec3 pane = mix(glass_tint.rgb, vec3(0.30, 0.48, 0.60), fresnel * 0.42) * pane_variation;\n    vec3 frame_color = window_light.rgb * (0.50 + lit * 0.28);\n    ALBEDO = mix(pane, frame_color, clamp(frame, 0.0, 1.0));\n    METALLIC = 0.48;\n    ROUGHNESS = mix(0.24, 0.38, clamp(frame, 0.0, 1.0));\n    SPECULAR = 0.58;\n}\n"
[resource]
shader = SubResource("Shader_window_grid")
resource_name = "WindowGrid_Procedural"
